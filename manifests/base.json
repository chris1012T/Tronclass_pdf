{
    "name": "Tronclass pdf",
    "description": "本擴充套件可下載Tronclass(iClass)上大多數教材，包括影片、音訊、PDF及PPT(以PDF格式下載)。",
    "version": "3.1.0",
    "manifest_version": 3,
    "action": {
        "default_icon": {
            "16": "/img/icon16.png",
            "24": "/img/icon24.png",
            "32": "/img/icon32.png",
            "48": "/img/icon48.png",
            "128": "/img/icon128.png"
        },
        "default_title": "請先開啟教材頁面再點我"
    },
    "icons": {
        "16": "/img/icon16.png",
        "24": "/img/icon24.png",
        "32": "/img/icon32.png",
        "48": "/img/icon48.png",
        "128": "/img/icon128.png"
    },
    "permissions": [
        "scripting",
        "activeTab",
        "contextMenus",
        "downloads",
        "storage"
    ]
}
